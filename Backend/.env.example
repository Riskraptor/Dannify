# Dannify environment configuration
#
# On Windows, paths auto-detect relative to the project directory.
# Override only if you need a custom location:
# DOWNLOAD_DIR="C:\Users\YourName\Music\Dannify"
# DATABASE_DIR="C:\Users\YourName\Desktop\dannify\Backend\data"
# WEB_GUI_LOCATION="C:\Users\YourName\Desktop\dannify\frontend\dist"
#
# On Linux / Docker, use Unix paths:
# DOWNLOAD_DIR="/downloads"
# DATABASE_DIR="/data"
# WEB_GUI_LOCATION="/dannify/frontend/dist"

DANNIFY_PORT="8000"

# Network binding. Default 127.0.0.1 = this machine only.
# HOST="0.0.0.0" makes it reachable from other devices on your LAN (phone, TV,
# other PCs). It then asks for a key: the address to open, key included, is
# printed at startup. Set DANNIFY_KEY to keep the same key across restarts.
# HOST="0.0.0.0"
# DANNIFY_KEY="

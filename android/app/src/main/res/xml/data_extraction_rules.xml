<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone in a backup or a phone-to-phone copy: the music's
     key is sealed by this phone's Keystore and would open nothing elsewhere. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>

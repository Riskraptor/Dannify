<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Dannify" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/dannify_background</item>
        <item name="android:colorAccent">@color/dannify_accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Google's page is light: its bars are too. -->
    <style name="Theme.Dannify.SignIn" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- While the backend starts: the mark on Dannify's own black. -->
    <style name="Theme.Dannify.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/dannify_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Dannify</item>
    </style>
</resources>

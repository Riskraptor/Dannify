<Window x:Class="Dannify.Setup.UI.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dannify"
        Width="640" Height="440"
        WindowStyle="None" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource Body}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        Opacity="0">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar" />
    </Window.TaskbarItemInfo>

    <Grid x:Name="Root" ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="128" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <!-- Two soft glows drifting behind everything. -->
        <Canvas Grid.RowSpan="4" IsHitTestVisible="False">
            <Ellipse Width="680" Height="680" Canvas.Left="-20" Canvas.Top="-420">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#401AD05C" Offset="0" />
                        <GradientStop Color="#161AD05C" Offset="0.45" />
                        <GradientStop Color="#001AD05C" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="GlowAShift" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="600" Height="600" Canvas.Left="300" Canvas.Top="170">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2410B8A0" Offset="0" />
                        <GradientStop Color="#0A10B8A0" Offset="0.5" />
                        <GradientStop Color="#0010B8A0" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TranslateTransform x:Name="GlowBShift" />
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>
        <Border x:Name="Edge" Grid.RowSpan="4" BorderThickness="1" BorderBrush="#1CFFFFFF" IsHitTestVisible="False" Visibility="Collapsed" />

        <!-- Top strip: drag anywhere here; minimise and close on the right. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,8,10,0" WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="MinButton" Style="{StaticResource ChromeButton}">
                <Path Data="M0,0.5 L10,0.5" StrokeThickness="1.2" Width="10" Height="1"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
            <Button x:Name="CloseButton" Style="{StaticResource ChromeCloseButton}" Margin="2,0,0,0">
                <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1.2" Width="10" Height="10"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
        </StackPanel>

        <!-- The mark, and what replaces it when there is news. -->
        <Grid x:Name="Hero" Grid.Row="1" Width="180" Height="128" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- In a zero-size canvas so the glow can spread past the hero's
                 box: a grid clips anything larger than itself. -->
            <Canvas Width="0" Height="0" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Ellipse x:Name="HeroGlow" Width="230" Height="230" Canvas.Left="-115" Canvas.Top="-115">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#5A1AD05C" Offset="0" />
                            <GradientStop Color="#1A1AD05C" Offset="0.45" />
                            <GradientStop Color="#001AD05C" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>
            <Image x:Name="LogoImage" Width="96" Height="96" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="LogoScale" ScaleX="1" ScaleY="1" />
                </Image.RenderTransform>
            </Image>
            <Grid x:Name="CheckBadge" Width="86" Height="86" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="CheckScale" ScaleX="0.6" ScaleY="0.6" />
                </Grid.RenderTransform>
                <Ellipse Fill="{StaticResource AccentFill}" />
                <Ellipse>
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#40FFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="0.55" />
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Path x:Name="CheckPath" Data="M27,44 L38,55 L60,32" Stroke="#FF03170B" StrokeThickness="6.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      StrokeDashArray="8 8" StrokeDashOffset="8" />
            </Grid>
            <Grid x:Name="WarnBadge" Width="86" Height="86" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="WarnScale" ScaleX="0.6" ScaleY="0.6" />
                </Grid.RenderTransform>
                <Ellipse Fill="{StaticResource AmberSoft}" Stroke="#40FFB547" StrokeThickness="1" />
                <Path Data="M43,24 L43,49" Stroke="{StaticResource Amber}" StrokeThickness="6.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                <Ellipse Width="8" Height="8" Fill="{StaticResource Amber}" Margin="0,38,0,0" />
            </Grid>
        </Grid>

        <!-- Pages. One is visible at a time. -->
        <Grid Grid.Row="2" Margin="40,2,40,0">
            <StackPanel x:Name="WelcomePage" VerticalAlignment="Top">
                <TextBlock x:Name="WelcomeTitle" Style="{StaticResource Wordmark}" Text="Dannify" />
                <TextBlock x:Name="WelcomeText" Style="{StaticResource Lead}" Margin="0,8,0,0" />
                <TextBlock x:Name="WelcomeNote" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="Collapsed" />
                <Button x:Name="WelcomePrimary" Style="{StaticResource PrimaryButton}" Margin="0,26,0,0" IsDefault="True" />
                <Button x:Name="WelcomeSecondary" Style="{StaticResource LinkButton}" Margin="0,12,0,0" />
            </StackPanel>

            <StackPanel x:Name="ProgressPage" VerticalAlignment="Top" Visibility="Collapsed">
                <TextBlock x:Name="ProgressTitle" Style="{StaticResource Heading}" Margin="0,6,0,0" />
                <Grid x:Name="Bar" Width="380" Height="6" Margin="0,28,0,0" HorizontalAlignment="Center" ClipToBounds="True">
                    <Border CornerRadius="3" Background="{StaticResource Track}" />
                    <Border x:Name="BarFill" CornerRadius="3" HorizontalAlignment="Left" Width="0" Background="{StaticResource AccentFill}" ClipToBounds="True">
                        <Border x:Name="Shimmer" Width="120" HorizontalAlignment="Left">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FFFFFF" Offset="0" />
                                    <GradientStop Color="#66FFFFFF" Offset="0.5" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ShimmerShift" X="-120" />
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                    <Border x:Name="BarSweep" CornerRadius="3" Width="120" HorizontalAlignment="Left" Background="{StaticResource AccentFill}" Visibility="Collapsed">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="SweepShift" X="-120" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>
                <Grid Width="380" Margin="0,12,0,0" HorizontalAlignment="Center">
                    <TextBlock x:Name="ProgressStep" Style="{StaticResource Caption}" HorizontalAlignment="Left" />
                    <TextBlock x:Name="ProgressPercent" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                </Grid>
                <Button x:Name="ProgressCancel" Style="{StaticResource LinkButton}" Margin="0,22,0,0" />
            </StackPanel>

            <StackPanel x:Name="ResultPage" VerticalAlignment="Top" Visibility="Collapsed">
                <TextBlock x:Name="ResultTitle" Style="{StaticResource Heading}" Margin="0,6,0,0" />
                <TextBlock x:Name="ResultText" Style="{StaticResource Lead}" Margin="0,10,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                    <Button x:Name="ResultPrimary" Style="{StaticResource PrimaryButton}" IsDefault="True" />
                    <Button x:Name="ResultSecondary" Style="{StaticResource GhostButton}" Margin="12,0,0,0" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="RemovePage" VerticalAlignment="Top" Visibility="Collapsed">
                <TextBlock x:Name="RemoveTitle" Style="{StaticResource Heading}" Margin="0,6,0,0" />
                <TextBlock x:Name="RemoveText" Style="{StaticResource Lead}" Margin="0,10,0,0" />
                <CheckBox x:Name="RemoveSettings" Style="{StaticResource SwitchRow}" Width="380" Margin="0,16,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <Button x:Name="RemovePrimary" Style="{StaticResource LightButton}" MinWidth="150" />
                    <Button x:Name="RemoveCancel" Style="{StaticResource GhostButton}" Margin="12,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="Footer" Grid.Row="3" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Top" />

        <!-- Options: a sheet that slides up over the welcome page. -->
        <Grid x:Name="Sheet" Grid.RowSpan="4" Visibility="Collapsed">
            <Border x:Name="SheetDim" Background="#99040706" />
            <Border x:Name="SheetCard" VerticalAlignment="Bottom" Margin="14,0,14,14" CornerRadius="18"
                    Background="#FF0F1511" BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="26,18,26,22">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SheetShift" Y="0" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.6" Color="#FF000000" />
                </Border.Effect>
                <StackPanel>
                    <Grid>
                        <TextBlock x:Name="SheetTitle" Style="{StaticResource Heading}" FontSize="19" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <Button x:Name="SheetClose" Style="{StaticResource ChromeButton}" HorizontalAlignment="Right">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1.3" Width="10" Height="10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </Grid>
                    <TextBlock x:Name="LocationLabel" Style="{StaticResource Label}" Margin="0,16,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Field}">
                            <TextBlock x:Name="LocationText" VerticalAlignment="Center" FontSize="13.5"
                                       Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <Button x:Name="LocationChange" Grid.Column="1" Style="{StaticResource FieldButton}" Margin="10,0,0,0" />
                    </Grid>
                    <TextBlock x:Name="LocationNote" Style="{StaticResource Caption}" Margin="2,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                    <Border Height="1" Background="{StaticResource Stroke}" Margin="0,16,0,6" />
                    <CheckBox x:Name="OptDesktop" Style="{StaticResource SwitchRow}" Margin="-14,0,-14,0" />
                    <CheckBox x:Name="OptLaunch" Style="{StaticResource SwitchRow}" Margin="-14,0,-14,0" />
                    <Button x:Name="SheetPrimary" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- A question in the middle of the window. -->
        <Grid x:Name="Confirm" Grid.RowSpan="4" Visibility="Collapsed">
            <Border Background="#B3040706" />
            <Border Style="{StaticResource Card}" Width="408" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="ConfirmTitle" Style="{StaticResource Heading}" FontSize="19" HorizontalAlignment="Left" TextAlignment="Left" />
                    <TextBlock x:Name="ConfirmText" Style="{StaticResource Lead}" FontSize="14" HorizontalAlignment="Left" TextAlignment="Left" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button x:Name="ConfirmNo" Style="{StaticResource GhostButton}" Height="40" MinWidth="112" />
                        <Button x:Name="ConfirmYes" Style="{StaticResource LightButton}" Height="40" MinWidth="120" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

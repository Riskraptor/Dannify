#!/bin/sh
# Dannify (/usr/bin/dannify). Runs the app from its own environment in
# /opt/dannify, as an installed copy: per-user folders, signed updates.
set -eu
APP=/opt/dannify
if [ ! -x "$APP/venv/bin/python3" ]; then
  echo "Dannify is not set up completely. Reinstall it with:" >&2
  echo "  sudo apt install --reinstall dannify" >&2
  exit 1
fi
DANNIFY_PACKAGED=1 exec "$APP/venv/bin/python3" "$APP/app/desktop.py" "$@"
